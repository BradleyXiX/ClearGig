generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum LineItemCategory {
  FRONTEND
  BACKEND
  CLOUD
  MAINTENANCE
}

model Client {
  id        String    @id @default(uuid())
  name      String
  email     String?
  createdAt DateTime  @default(now())
  projects  Project[]

  @@map("clients")
}

model Project {
  id                    String        @id @default(uuid())
  clientId              String
  title                 String
  status                ProjectStatus @default(DRAFT)
  contingencyPercentage Decimal?      @default(0.0)
  profitMargin          Decimal?      @default(0.0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  client    Client     @relation(fields: [clientId], references: [id])
  lineItems LineItem[]

  @@map("projects")
}

model LineItem {
  id             String           @id @default(uuid())
  projectId      String
  category       LineItemCategory
  description    String
  estimatedHours Decimal
  hourlyRate     Decimal
  isRecurring    Boolean          @default(false)

  project Project @relation(fields: [projectId], references: [id])

  @@map("line_items")
}
